{
  "name": "geogo_video",
  "version": "1.0.0",
  "private": true,
  "description": "geogames.site için 60 saniyelik reklam videosu otomasyonu",
  "type": "module",
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "render": "node scripts/render.mjs --preset genel --format 16x9",
